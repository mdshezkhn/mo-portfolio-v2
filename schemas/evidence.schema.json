{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Evidence Schema v1.0",
  "type": "object",
  "required": ["id", "schemaVersion", "filename", "type", "date_issued"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^E-\\d+$"
    },
    "schemaVersion": {
      "type": "string",
      "enum": ["1.0"]
    },
    "filename": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": ["certificate", "letter", "transcript", "publication", "reference"]
    },
    "date_issued": {
      "type": "string",
      "format": "date"
    }
  },
  "additionalProperties": true
}
