{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1.0
    },
    "voice": {
      "type": "object",
      "properties": {
        "tone": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "vocabulary_preferences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prohibited_terms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "tone"
      ]
    }
  },
  "required": [
    "schema_version",
    "voice"
  ]
}